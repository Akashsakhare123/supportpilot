{
  "name": "@supportpilot/worker",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "description": "SupportPilot background worker: BullMQ ingestion jobs",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage"
  },
  "dependencies": {
    "@bull-board/api": "^6.5.0",
    "@bull-board/express": "^6.5.0",
    "@sentry/node": "^11.9.0",
    "@supportpilot/ai": "workspace:*",
    "@supportpilot/db": "workspace:*",
    "@supportpilot/shared": "workspace:*",
    "bullmq": "^5.53.0",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
