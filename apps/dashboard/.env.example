# Copy to apps/dashboard/.env.local
# Where the Next.js server proxies /api/* (keeps the refresh cookie first-party)
API_INTERNAL_URL=http://localhost:4000
# Used by the server-rendered status card on the home page
NEXT_PUBLIC_API_URL=http://localhost:4000
# Base URL that serves widget.js (used in the embed snippet shown to customers)
NEXT_PUBLIC_WIDGET_URL=http://localhost:5173
