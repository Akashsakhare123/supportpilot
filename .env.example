# Copy to .env in the repo root:  cp .env.example .env
# Read by apps/api, apps/worker and packages/db scripts.
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://supportpilot:supportpilot@localhost:5434/supportpilot
# Used by `pnpm test:integration` when set (created by docker compose on first start)
DATABASE_URL_TEST=postgres://supportpilot:supportpilot@localhost:5434/supportpilot_test
REDIS_URL=redis://localhost:6379
# Comma-separated origins allowed to call the API (dashboard, widget dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Dashboard URL (used in invite links)
APP_URL=http://localhost:3000
# Signs access tokens. Use a long random value; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-this-must-be-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Embeddings for knowledge-base search (T05).
#   local  = built-in offline embeddings: free, no key, keyword-level matching (default)
#   openai = text-embedding-3-small (meaning-based search); needs OPENAI_API_KEY
# After switching provider, re-ingest documents (vectors of different models are never mixed).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
OPENAI_API_KEY=
# Ingestion worker (T06): jobs processed in parallel, and the dev-only Bull Board queue UI
# (http://localhost:4100; 0 = off). Uploads are stored in STORAGE_DIR (default <repo>/.data/uploads),
# or in an S3-compatible bucket in production (T16): STORAGE_DRIVER=s3 + S3_* below.
WORKER_CONCURRENCY=2
BULL_BOARD_PORT=4100
# Answers (T07).
#   mock   = built-in offline assistant: free, no key, quotes your help articles (default)
#   openai = OpenAI (set OPENAI_API_KEY) or any OpenAI-compatible server via OPENAI_BASE_URL,
#            e.g. a free local Ollama: OPENAI_BASE_URL=http://localhost:11434 LLM_MODEL=llama3.2
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_BASE_URL=
# Stripe billing (T13). Optional: without these the Billing page shows plans and usage, upgrades are off.
# Test mode only in development: https://dashboard.stripe.com/test/apikeys
#   STRIPE_PRICE_*        = recurring monthly prices you create in test mode (Products > Add product)
#   STRIPE_WEBHOOK_SECRET = printed by `pnpm stripe:listen` (Stripe CLI), starts with whsec_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Security (T15). Rate limits are multiplied by RATE_LIMIT_MULTIPLIER (0 = off). TRUST_PROXY says
# which proxies may set X-Forwarded-For (loopback = the dashboard's /api proxy; in production the
# platform's proxy, e.g. 1 for one hop).
RATE_LIMIT_MULTIPLIER=1
TRUST_PROXY=loopback
# Upload storage (T16). local = STORAGE_DIR folder (development). s3 = a private S3-compatible
# bucket shared by the API and the worker (Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com).
STORAGE_DRIVER=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Error tracking (T16): Sentry DSN for the API and the worker (empty = off).
SENTRY_DSN=
