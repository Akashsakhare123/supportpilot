{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "VITE_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "REDIS_URL",
        "JWT_SECRET",
        "LLM_PROVIDER",
        "EMBEDDING_PROVIDER"
      ]
    },
    "migrate": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "REDIS_URL",
        "JWT_SECRET",
        "LLM_PROVIDER",
        "EMBEDDING_PROVIDER"
      ]
    }
  }
}
